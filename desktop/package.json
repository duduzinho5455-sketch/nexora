{
  "name": "nexora-desktop",
  "productName": "Auryx Nexavória",
  "version": "1.0.0",
  "description": "Auryx Nexavória para Windows — chat, voz, tela e jogos com os amigos",
  "author": "Auryx Nexavória",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nexora.app",
    "productName": "Auryx Nexavória",
    "artifactName": "Auryx-Nexavoria-Setup.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "picker-preload.js", "picker.html", "offline.html", "build/icon.png"],
    "extraResources": [{ "from": "agente/nexora-agente.ps1", "to": "agente/nexora-agente.ps1" }],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Auryx Nexavória",
      "deleteAppDataOnUninstall": false
    }
  }
}
