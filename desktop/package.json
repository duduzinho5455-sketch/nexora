{
  "name": "nexora-desktop",
  "productName": "Auryx Nexos",
  "version": "1.0.0",
  "description": "Auryx Nexos para Windows — chat, voz, tela e jogos com os amigos",
  "author": "Auryx Nexos",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nexora.app",
    "productName": "Auryx Nexos",
    "artifactName": "Auryx-Nexos-Setup.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "picker-preload.js",
      "picker.html",
      "offline.html",
      "build/icon.png",
      "overlay.html",
      "overlay.js",
      "overlay-preload.js"
    ],
    "extraResources": [
      {
        "from": "agente/nexora-agente.ps1",
        "to": "agente/nexora-agente.ps1"
      },
      {
        "from": "vigem",
        "to": "vigem",
        "filter": ["ViGEmBus-Setup.exe", "LICENCA-ViGEmBus.txt"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Auryx Nexos",
      "deleteAppDataOnUninstall": false
    }
  }
}
